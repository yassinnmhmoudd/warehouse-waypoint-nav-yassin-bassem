Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 1
      Color Scheme: map
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
      Size (m): 0.05
      Color: 255; 0; 0
      Enabled: true
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: GlobalCostmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.4
      Color Scheme: costmap
      Enabled: true
    - Class: rviz_default_plugins/Map
      Name: LocalCostmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
      Alpha: 0.4
      Color Scheme: costmap
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: GlobalPlan
      Topic:
        Value: /plan
      Color: 0; 255; 0
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: LocalPlan
      Topic:
        Value: /local_plan
      Color: 255; 165; 0
      Enabled: true
    - Class: rviz_default_plugins/PoseArray
      Name: AMCLParticles
      Topic:
        Value: /particlecloud
      Arrow Alpha: 1
      Arrow Length: 0.2
      Color: 255; 0; 255
      Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: WaypointMarkers
      Topic:
        Value: /waypoint_markers
      Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point:
        X: -6
        Y: -8
        Z: 0
      Name: Current View
      Pitch: 0.9
      Yaw: 0.0
Window Geometry:
  Height: 900
  Width: 1600
